<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HonorHelper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- G-Helper 风格浅色布局：扁平分区、图标瓷砖按钮、选中彩色描边。
         颜色全部内联：旧版 net472 XAML 编译器对资源字典有限制（README 有记录）。 -->

    <!-- 注意：WinUI 3 的 Window 没有 Resources 属性（不是 FrameworkElement），
         样式必须挂在根 Grid.Resources 下，否则旧版 XamlCompiler 会静默崩溃。 -->
    <Grid x:Name="Root" RequestedTheme="Light" Background="#FAFAFA">
        <Grid.Resources>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="#D8D8DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="2,10,2,10" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="#D8D8DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,2,12,2" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="TickButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#70707A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="22" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111114" />
        </Style>

        <Style x:Key="SectionNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#9A9AA2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="H-Helper — HONOR WIN H7" 
                            FontSize="14" 
                            FontWeight="SemiBold" 
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16,2,16,12" Spacing="12">

                <!-- 管理员警告 -->
                <TextBlock x:Name="AdminText" FontSize="12" Foreground="#C42B1C"
                           Visibility="Collapsed" TextWrapping="Wrap" />

                <!-- ===== 性能模式 ===== -->
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="⚡ " FontSize="14" />
                            <TextBlock Text="性能模式: " Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="PerfModeRun" Text="—" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="12.5" Foreground="#3A3A40" VerticalAlignment="Center">
                            <Run x:Name="TempRun" Text="" />
                            <Run x:Name="TempGpuRun" Text="" />
                        </TextBlock>
                    </Grid>

                    <Grid ColumnSpacing="8" x:Name="ModeTileGrid" MinHeight="88">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnModeSmart" Grid.Column="0" Tag="smart" Click="OnModeClick"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Style="{StaticResource TileButton}">
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="ModeIconSmart" Text="🚲" FontSize="20" HorizontalAlignment="Center" />
                                <TextBlock x:Name="ModeLabelSmart" Text="智能模式" FontSize="12.5" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnModeHigh" Grid.Column="1" Tag="high" Click="OnModeClick"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Style="{StaticResource TileButton}">
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="ModeIconHigh" Text="🚀" FontSize="20" HorizontalAlignment="Center" />
                                <TextBlock x:Name="ModeLabelHigh" Text="高能模式" FontSize="12.5" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnModeBeast" Grid.Column="2" Tag="beast" Click="OnModeClick"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Style="{StaticResource TileButton}">
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="ModeIconBeast" Text="🔥" FontSize="20" HorizontalAlignment="Center" />
                                <TextBlock x:Name="ModeLabelBeast" Text="狂战模式" FontSize="12.5" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- PPM 面板：点狂战模式自动展开，切到其它模式自动收起。
                         PpmValueText 必须在 Slider 之前：解析 Value="3" 会立刻触发
                         ValueChanged，而该 handler 会访问 PpmValueText。 -->
                    <Border x:Name="PpmPanel" Background="White" BorderBrush="#E2E2E6"
                            BorderThickness="1" CornerRadius="8" Padding="12,10,12,10"
                            Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="PPM 功率级别" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#111114" VerticalAlignment="Center" />
                                <TextBlock x:Name="PpmValueText" Text="PPM 3 · Beast" FontSize="12"
                                           Foreground="#5A5A64" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Slider x:Name="PpmSlider" Minimum="0" Maximum="4" StepFrequency="1" Value="3"
                                    ValueChanged="OnPpmValueChanged" PointerReleased="OnPpmPointerReleased"
                                    Margin="2,0,2,0" />
                            <!-- 刻度标签对齐滑条落点：滑条轨道两端有约半拇指宽的内缩，
                                 标签行用同等 Margin 补偿；首档左对齐、末档右对齐、
                                 中间三档等分居中（25/50/75% 恰为落点）。 -->
                            <Grid Margin="14,0,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnPpm0" Grid.Column="0" Tag="0" Click="OnPpmClick"
                                        Style="{StaticResource TickButton}" Content="0 平衡"
                                        HorizontalContentAlignment="Left" />
                                <Button x:Name="BtnPpm1" Grid.Column="1" Tag="1" Click="OnPpmClick"
                                        Style="{StaticResource TickButton}" Content="1" />
                                <Button x:Name="BtnPpm2" Grid.Column="2" Tag="2" Click="OnPpmClick"
                                        Style="{StaticResource TickButton}" Content="2" />
                                <Button x:Name="BtnPpm3" Grid.Column="3" Tag="3" Click="OnPpmClick"
                                        Style="{StaticResource TickButton}" Content="3 Beast" />
                                <Button x:Name="BtnPpm4" Grid.Column="4" Tag="4" Click="OnPpmClick"
                                        Style="{StaticResource TickButton}" Content="4 极限"
                                        HorizontalContentAlignment="Right" />
                            </Grid>
                            <TextBlock FontSize="11" Foreground="#8A8A92" TextWrapping="Wrap"
                                       Text="拖动滑条或点刻度写入（仅狂战模式接受，失败自动切狂战重试）。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== 风扇（02 08 <id>，EC 共 3 通道，详见 README 命令表） ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="🌀 " FontSize="14" />
                        <TextBlock Text="风扇" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock x:Name="FanRunsText" Grid.Column="1" FontSize="12.5" Foreground="#3A3A40"
                               VerticalAlignment="Center">
                        <Run x:Name="FanCpuRun" Text="" />
                        <Run x:Name="FanGpuRun" Text="" />
                        <Run x:Name="Fan3Run" Text="" />
                    </TextBlock>
                </Grid>

                <!-- ===== 温度（Get-HonorTemps.ps1 的通道表，4 列网格） ===== -->
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="🌡️ " FontSize="14" />
                            <TextBlock Text="温度" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <TextBlock x:Name="TempsUpdatedText" Grid.Column="1" Style="{StaticResource SectionNote}" Text="" />
                    </Grid>
                    <Border Background="White" BorderBrush="#E2E2E6" BorderThickness="1"
                            CornerRadius="8" Padding="12,10,12,12">
                        <Grid x:Name="TempsGrid" ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 单元格由代码按 TempChannels 生成；风扇转速在上方「风扇」标题栏 -->
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ===== 触控板（02 0F FF 读 / 02 10 写，状态随温度轮询回读同步） ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 行高被右侧开关撑高，标题栈必须垂直居中，否则"已开启"相对整行居中会下垂 -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="🖱️ " FontSize="14" />
                        <TextBlock Text="触控板" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="TouchpadNoteText" FontSize="11" Foreground="#9A9AA2"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <ToggleSwitch x:Name="TouchpadToggle" Grid.Column="1" Toggled="OnTouchpadToggled"
                                  OnContent="开" OffContent="关" MinWidth="0" Margin="0,0,0,0"
                                  HorizontalAlignment="Right" IsEnabled="False" />
                </Grid>

                <!-- ===== GPU 锁频修复（移植 Enable-DynamicPstates.ps1） ===== -->
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="🧩 " FontSize="14" />
                            <TextBlock Text="GPU 锁频修复" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <Button x:Name="BtnGpuFix" Grid.Column="1" Click="OnGpuFixClick"
                                ToolTipService.ToolTip="解锁被荣耀管家游戏场景钉死的 GPU 频率（NvAPI 动态 P 状态 + nvidia-smi -rgc，需管理员）"
                                Style="{StaticResource PillButton}" Height="28" Padding="10,2,10,2" FontSize="11.5">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="🛠️" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="一键修复" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border x:Name="GpuFixInfoText" Background="White" BorderBrush="#E2E2E6"
                            BorderThickness="1" CornerRadius="8" Padding="12,10,12,10"
                            Visibility="Collapsed">
                        <TextBlock FontSize="11.5" Foreground="#5A5A64" TextWrapping="Wrap"
                                   FontFamily="Consolas" />
                    </Border>
                </StackPanel>

                <!-- ===== 状态栏 ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="正在获取当前模式…" FontSize="12"
                               Foreground="#6A6A72" VerticalAlignment="Center"
                               Margin="0,0,10,0" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnSettings" Click="OnSettingsClick"
                                ToolTipService.ToolTip="采样率与程序联动设置"
                                Style="{StaticResource PillButton}" MinWidth="76">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="设置" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnRefresh" Click="OnRefresh"
                                Style="{StaticResource PillButton}" MinWidth="76">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="🔄" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="刷新" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
